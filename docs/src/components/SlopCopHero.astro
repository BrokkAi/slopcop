---
import type { StarlightRouteData } from '@astrojs/starlight/route-data';

const { entry } = (Astro.locals as { starlightRoute: StarlightRouteData }).starlightRoute;
const { title = entry.data.title, tagline, actions = [] } = entry.data.hero ?? {};
---

<div class="sc-hero">
  <div class="sc-hero__copy">
    <h1 id="_top" data-page-title set:html={title} />
    {tagline && <p class="sc-hero__lead" set:html={tagline} />}
    {
      actions.length > 0 && (
        <div class="sc-hero__actions">
          {/* One solid button a view: the primary action. The rest are line buttons. */}
          {actions.map(({ attrs: { class: className, ...attrs } = {}, link: href, text, variant }) => (
            <a href={href} class:list={['sc-button', variant === 'primary' ? 'is-solid' : 'is-line', className]} {...attrs}>
              {text}
            </a>
          ))}
        </div>
      )
    }
  </div>
  <figure class="sc-hero__report" aria-label="A SlopCop check run from a terminal">
    <div class="sc-tag is-lead">
      {/* One span a line, so a line too long for a phone wraps under itself and not back at the margin. */}
      <pre><code><span><i>$</i> slopcop</span><span><em>orders/ExportServlet.java:48</em>  <u>definite · error</u></span><span class="in">  request parameter reaches SQL text</span><span class="in">  ID: 0f8fad5b-d9cb-469f-a165-70867728950e</span><span class="in">  bifrost.security.java.servlet-parameter-to-jdbc:</span><span class="in">  req.getParameter("q") reaches Statement.executeQuery</span><span class="in">  through OrderQuery.build (OrderQuery.java:21)</span><span class="gap"></span><span>1 new finding across 1 file(s); 72 already in the code</span><span>Analysis complete</span><span><i>$</i> echo $?</span><span>1</span></code></pre>
    </div>
    <figcaption>Static analysis · proven data flows · read-only</figcaption>
  </figure>
</div>

<style>
  @layer starlight.user {
    .sc-hero {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--sc-8) var(--sc-9);
      align-items: center;
      padding-block: var(--sc-9) var(--sc-4);
    }
    /* The page's one headline, in the display face. */
    .sc-hero h1 {
      margin: 0;
      font: 400 var(--sc-t-display) / 0.96 var(--sc-display);
      letter-spacing: -0.022em;
      text-wrap: balance;
      color: var(--sc-fg);
    }
    .sc-hero h1 :global(span) { display: block; }
    .sc-hero__lead {
      margin: var(--sc-6) 0 0;
      max-width: 30em;
      font-size: var(--sc-t-lead);
      line-height: 1.4;
      color: var(--sc-fg);
    }
    .sc-hero__lead :global(code) { font-family: var(--sc-mono); font-size: 0.86em; padding: 0.08em 0.3em; background: var(--sc-well); }
    .sc-hero__actions { display: flex; flex-wrap: wrap; gap: var(--sc-3); margin-top: var(--sc-7); }
    .sc-hero__report { margin: 0; min-width: 0; }
    /* What the machine printed, on a tag that leads. Red is the finding's and nothing else's. */
    .sc-hero__report pre {
      margin: 0;
      padding: var(--sc-5) var(--sc-6) var(--sc-6);
      font: 400 var(--sc-t-mono) / 21px var(--sc-mono);
      color: var(--sc-fg);
      white-space: pre-wrap;
      overflow-wrap: anywhere;
    }
    .sc-hero__report pre span { display: block; padding-inline-start: 2ch; text-indent: -2ch; }
    .sc-hero__report pre span.in { padding-inline-start: 4ch; text-indent: -4ch; }
    .sc-hero__report pre span.gap { height: 21px; }
    .sc-hero__report pre i { font-style: normal; color: var(--sc-quiet); }
    .sc-hero__report pre em { font-style: normal; font-weight: 700; }
    .sc-hero__report pre u { text-decoration: none; color: var(--sc-mark-text); white-space: nowrap; }
    .sc-hero__report figcaption { margin-top: var(--sc-2); color: var(--sc-quiet); font-size: var(--sc-t-note); line-height: 20px; }
    /* Side by side only where the report's longest line fits its half without breaking. */
    @media (max-width: 72rem) {
      .sc-hero { grid-template-columns: 1fr; padding-block-start: var(--sc-8); }
    }
    @media (max-width: 40rem) {
      .sc-hero__report pre { padding: var(--sc-4) var(--sc-4) var(--sc-5); }
    }
  }
</style>
