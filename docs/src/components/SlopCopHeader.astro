---
import LanguageSelect from '@astrojs/starlight/components/LanguageSelect.astro';
import Search from '@astrojs/starlight/components/Search.astro';
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';
import ThemeSelect from './SlopCopThemeSelect.astro';
import type { StarlightRouteData } from '@astrojs/starlight/route-data';

const { siteTitleHref } = (Astro.locals as { starlightRoute: StarlightRouteData }).starlightRoute;
const root = siteTitleHref.endsWith('/') ? siteTitleHref : `${siteTitleHref}/`;
const navItems = [
  { label: 'Quickstart', slug: 'get-started/quickstart/' },
  { label: 'Agents', slug: 'agents/overview/' },
  { label: 'Checks', slug: 'checks/run-a-check/' },
  { label: 'Reference', slug: 'reference/cli/' },
];
const currentPath = Astro.url.pathname.replace(/\/+$/, '/');
---

<div class="sc-header">
  <div class="sc-brand sl-flex"><SiteTitle /></div>

  <nav class="sc-nav print:hidden" aria-label="Primary">
    {
      navItems.map(({ label, slug }) => {
        const href = `${root}${slug}`;
        const current = currentPath === href || currentPath.startsWith(href.replace(/[^/]+\/$/, ''));
        return <a href={href} aria-current={current ? 'page' : undefined}>{label}</a>;
      })
    }
    <a href="https://slopcop.com">slopcop.com</a>
  </nav>

  <div class="sc-search sl-flex print:hidden"><Search /></div>
  <div class="sc-tools sl-hidden md:sl-flex print:hidden">
    <div class="sl-flex social-icons"><SocialIcons /></div>
    <ThemeSelect />
    <LanguageSelect />
  </div>
</div>

<style>
  @layer starlight.user {
    /* The bar: the wordmark on the left, everything else on the right, in the sans at 16. */
    .sc-header {
      display: flex;
      align-items: center;
      gap: var(--sc-4);
      height: 100%;
      max-width: var(--sc-stage);
      margin-inline: auto;
    }
    .sc-brand { align-items: center; min-width: 0; margin-inline-end: auto; }
    .sc-nav { display: none; align-items: center; gap: var(--sc-6); margin-inline-end: var(--sc-2); }
    .sc-nav a {
      color: var(--sc-quiet);
      font-size: 16px;
      line-height: 24px;
      text-decoration: none;
      white-space: nowrap;
    }
    /* The current section is told by lightness, as in the rail. */
    .sc-nav a:hover, .sc-nav a[aria-current='page'] { color: var(--sc-fg); }
    .sc-search { min-width: 0; }
    .sc-search :global(button[data-open-modal]) { max-width: none; }
    .sc-tools, .social-icons { align-items: center; gap: var(--sc-1); }
    /* Every tool is a 36 px square with a centred mark, drawn in the text colour. */
    .social-icons :global(a) {
      display: flex;
      width: 36px;
      height: 36px;
      padding: 0;
      margin: 0;
      align-items: center;
      justify-content: center;
      color: var(--sc-fg);
      font-size: 18px;
    }
    .social-icons :global(a:hover) { background: var(--sc-tint); color: var(--sc-fg); }
    @media (min-width: 50rem) {
      .sc-search { width: 220px; }
    }
    @media (min-width: 72rem) {
      .sc-header { gap: var(--sc-6); }
      .sc-nav { display: flex; }
    }
  }
</style>
